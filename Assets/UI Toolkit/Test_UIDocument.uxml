<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/USS/test_uss.uss?fileID=7433441132597879392&amp;guid=c3b2fb9dc7ee565409b1e624cf2741cc&amp;type=3#test_uss" />
    <ui:VisualElement name="MainContainer" style="align-items: flex-start; width: 100%; height: 100%;">
        <ui:VisualElement name="MainMenu" style="height: 100%; width: 100%; min-width: auto; min-height: auto;">
            <ui:GroupBox name="Title" style="align-items: center; width: 100%; padding-top: 81px;">
                <ui:Label text="cалам алейкум " display-tooltip-when-elided="true" class="header basic-font" style="-unity-font-style: bold; font-size: 63px; padding-top: 0; -unity-font: url(&apos;project://database/Assets/Fonts/RubikDirt-Regular.ttf?fileID=12800000&amp;guid=569fc768f3bee5a4181dffc018679f88&amp;type=3#RubikDirt-Regular&apos;); width: 603px;" />
            </ui:GroupBox>
            <ui:GroupBox name="Buttons" style="margin-left: 108px; font-size: 105%; width: 50%; height: 70%;">
                <ui:Button text="Найти" display-tooltip-when-elided="true" class="button basic-font" style="transition-property: opacity; transition-duration: 1s; transition-delay: 1s; align-items: flex-start;" />
                <ui:Button text="Создать" display-tooltip-when-elided="true" class="button basic-font" style="transition-property: opacity; transition-duration: 1s; transition-delay: 1s; align-items: flex-start;" />
                <ui:Button text="Настройки" display-tooltip-when-elided="true" class="button basic-font" style="transition-property: opacity; transition-duration: 1s; transition-delay: 1s; align-items: flex-start;" />
                <ui:Button text="Выход" display-tooltip-when-elided="true" class="button basic-font" style="transition-property: opacity; transition-duration: 1s; transition-delay: 1s; align-items: flex-start;" />
            </ui:GroupBox>
        </ui:VisualElement>
        <ui:VisualElement name="ServerMenu" style="width: 100%; height: 100%; left: -2px; top: 0; position: absolute; min-width: auto; min-height: auto; visibility: visible;">
            <ui:VisualElement name="ServerMenuWindow" style="width: 80%; height: 80%; left: 10%; top: 10%; background-color: rgba(89, 89, 89, 0.95); border-top-left-radius: 19px; border-bottom-left-radius: 19px; border-top-right-radius: 19px; border-bottom-right-radius: 19px;">
                <ui:VisualElement name="Servers" style="width: 96%; height: 85%; left: 2%; top: 2%; background-color: rgba(51, 51, 51, 0.95); border-top-left-radius: 19px; border-bottom-left-radius: 19px; border-top-right-radius: 19px; border-bottom-right-radius: 19px;" />
                <ui:VisualElement name="Buttons" style="width: 96%; height: 8%; left: 2%; top: 2%; background-color: rgba(51, 51, 51, 0); border-top-left-radius: 19px; border-bottom-left-radius: 19px; border-top-right-radius: 19px; border-bottom-right-radius: 19px; margin-top: 2%; flex-direction: row; justify-content: hidden;">
                    <ui:Button text="Войти" display-tooltip-when-elided="true" class="server-button" />
                    <ui:Button text="Добавить" display-tooltip-when-elided="true" class="basic-font server-button" />
                    <ui:Button text="Удалить" display-tooltip-when-elided="true" class="basic-font server-button" />
                    <ui:Button text="Выход" display-tooltip-when-elided="true" class="basic-font server-button" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
